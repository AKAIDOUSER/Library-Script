javascript:(function() {
    // ============================================
    // REMOTE SPY PRO - Bookmarklet v2.0
    // ============================================
    
    // Estilos CSS
    const styles = `
        :root {
            --spy-bg: #0a0e1a;
            --spy-primary: #00f5d4;
            --spy-secondary: #7b2ffc;
            --spy-danger: #ff6b6b;
            --spy-warning: #feca57;
            --spy-success: #2ecc71;
            --spy-text: #e0e0e0;
            --spy-card: rgba(255,255,255,0.05);
            --spy-border: rgba(0,245,212,0.2);
            --spy-radius: 12px;
            --spy-shadow: 0 8px 32px rgba(0,0,0,0.8);
            --spy-font: 'Courier New', monospace;
        }
        
        #spy-root {
            all: initial;
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: min(90vw, 600px);
            max-height: 80vh;
            background: var(--spy-bg);
            color: var(--spy-text);
            font-family: var(--spy-font);
            border-radius: var(--spy-radius);
            border: 1px solid var(--spy-border);
            box-shadow: var(--spy-shadow);
            z-index: 999999;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }
        
        #spy-root.minimized {
            width: auto;
            max-height: 50px;
        }
        
        #spy-root.minimized #spy-body {
            display: none;
        }
        
        #spy-header {
            padding: 12px 16px;
            background: linear-gradient(135deg, var(--spy-secondary), var(--spy-primary));
            cursor: move;
            display: flex;
            justify-content: space-between;
            align-items: center;
            user-select: none;
            flex-shrink: 0;
        }
        
        #spy-title {
            font-weight: bold;
            font-size: 14px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        #spy-title .badge {
            background: rgba(255,255,255,0.2);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
        }
        
        #spy-title .badge.saved {
            background: var(--spy-success);
        }
        
        #spy-controls {
            display: flex;
            gap: 6px;
            align-items: center;
        }
        
        #spy-controls button {
            background: rgba(255,255,255,0.1);
            border: none;
            color: #fff;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        #spy-controls button:hover {
            background: rgba(255,255,255,0.25);
        }
        
        #spy-toolbar {
            padding: 8px 12px;
            background: rgba(0,0,0,0.3);
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            border-bottom: 1px solid var(--spy-border);
            flex-shrink: 0;
        }
        
        #spy-toolbar input {
            flex: 1;
            min-width: 100px;
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--spy-border);
            border-radius: 6px;
            padding: 4px 10px;
            color: #fff;
            font-family: var(--spy-font);
            font-size: 11px;
        }
        
        #spy-toolbar input::placeholder {
            color: rgba(255,255,255,0.3);
        }
        
        #spy-toolbar select {
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--spy-border);
            border-radius: 6px;
            padding: 4px 8px;
            color: #fff;
            font-size: 11px;
            font-family: var(--spy-font);
        }
        
        #spy-toolbar select option {
            background: #1a1a2e;
        }
        
        .spy-btn {
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--spy-border);
            border-radius: 6px;
            padding: 4px 10px;
            color: #fff;
            cursor: pointer;
            font-size: 11px;
            font-family: var(--spy-font);
            transition: 0.2s;
            white-space: nowrap;
        }
        
        .spy-btn:hover {
            background: rgba(255,255,255,0.15);
        }
        
        .spy-btn.primary {
            background: var(--spy-secondary);
            border-color: var(--spy-secondary);
        }
        
        .spy-btn.primary:hover {
            background: #8f4ffc;
        }
        
        .spy-btn.danger {
            background: var(--spy-danger);
            border-color: var(--spy-danger);
        }
        
        .spy-btn.danger:hover {
            background: #ff7a7a;
        }
        
        .spy-btn.success {
            background: var(--spy-success);
            border-color: var(--spy-success);
        }
        
        .spy-btn.success:hover {
            background: #40d47e;
        }
        
        #spy-body {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
            min-height: 100px;
            max-height: 50vh;
        }
        
        #spy-body::-webkit-scrollbar {
            width: 4px;
        }
        
        #spy-body::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
        }
        
        #spy-body::-webkit-scrollbar-thumb {
            background: var(--spy-primary);
            border-radius: 2px;
        }
        
        .spy-entry {
            background: var(--spy-card);
            border-left: 3px solid var(--spy-primary);
            border-radius: 6px;
            padding: 8px 10px;
            margin-bottom: 6px;
            font-size: 11px;
            cursor: pointer;
            transition: 0.2s;
            position: relative;
        }
        
        .spy-entry:hover {
            background: rgba(255,255,255,0.08);
        }
        
        .spy-entry.highlight {
            border-left-color: var(--spy-warning);
            background: rgba(254,202,87,0.1);
        }
        
        .spy-entry.saved-indicator {
            border-left-color: var(--spy-success);
        }
        
        .spy-entry .method {
            display: inline-block;
            font-weight: bold;
            padding: 0 6px;
            border-radius: 3px;
            margin-right: 6px;
            font-size: 10px;
        }
        
        .spy-entry .method.GET { color: #4ecdc4; }
        .spy-entry .method.POST { color: #ff6b6b; }
        .spy-entry .method.PUT { color: #feca57; }
        .spy-entry .method.DELETE { color: #ff4757; }
        .spy-entry .method.WS_SEND { color: #a29bfe; }
        .spy-entry .method.WS_RECV { color: #fd79a8; }
        
        .spy-entry .url {
            color: #a8e6cf;
            word-break: break-all;
        }
        
        .spy-entry .path {
            color: #7b2ffc;
            font-weight: bold;
        }
        
        .spy-entry .body-preview {
            color: rgba(255,255,255,0.5);
            font-size: 10px;
            margin-top: 4px;
            padding: 4px 6px;
            background: rgba(0,0,0,0.3);
            border-radius: 4px;
            max-height: 60px;
            overflow: hidden;
            white-space: pre-wrap;
            word-break: break-all;
        }
        
        .spy-entry .actions {
            display: none;
            gap: 4px;
            margin-top: 6px;
            flex-wrap: wrap;
        }
        
        .spy-entry:hover .actions {
            display: flex;
        }
        
        .spy-entry .actions button {
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--spy-border);
            border-radius: 4px;
            padding: 2px 8px;
            color: var(--spy-text);
            cursor: pointer;
            font-size: 10px;
            font-family: var(--spy-font);
            transition: 0.2s;
        }
        
        .spy-entry .actions button:hover {
            background: rgba(255,255,255,0.15);
        }
        
        .spy-entry .timestamp {
            color: rgba(255,255,255,0.3);
            font-size: 9px;
            float: right;
        }
        
        .spy-entry .save-status {
            color: var(--spy-success);
            font-size: 9px;
            margin-left: 4px;
        }
        
        #spy-status {
            padding: 6px 12px;
            background: rgba(0,0,0,0.2);
            border-top: 1px solid var(--spy-border);
            font-size: 10px;
            color: rgba(255,255,255,0.4);
            display: flex;
            justify-content: space-between;
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 4px;
        }
        
        #spy-status .count {
            color: var(--spy-primary);
        }
        
        #spy-status .saved-count {
            color: var(--spy-success);
        }
        
        .spy-storage-info {
            background: rgba(0,0,0,0.3);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 9px;
            color: rgba(255,255,255,0.4);
        }
        
        @media (max-width: 768px) {
            #spy-root {
                bottom: 10px;
                right: 10px;
                width: 95vw;
                max-height: 85vh;
            }
            
            #spy-toolbar {
                padding: 6px 8px;
                gap: 4px;
            }
            
            #spy-toolbar input {
                min-width: 60px;
                font-size: 10px;
            }
            
            .spy-btn {
                font-size: 10px;
                padding: 3px 6px;
            }
            
            .spy-entry {
                font-size: 10px;
                padding: 6px 8px;
            }
            
            .spy-entry .actions {
                display: flex;
            }
            
            #spy-body {
                max-height: 40vh;
                min-height: 60px;
            }
        }
    `;

    // ============================================
    // INJECT STYLES
    // ============================================
    if (!document.getElementById('spy-styles')) {
        const styleEl = document.createElement('style');
        styleEl.id = 'spy-styles';
        styleEl.textContent = styles;
        document.head.appendChild(styleEl);
    }

    // ============================================
    // STORAGE MANAGER
    // ============================================
    const STORAGE_KEY = 'remote_spy_entries';
    const MAX_STORAGE_ENTRIES = 1000;

    function saveToStorage(entries) {
        try {
            // Limitar quantidade de entradas para não estourar o storage
            const toSave = entries.slice(-MAX_STORAGE_ENTRIES);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(toSave));
            return true;
        } catch (e) {
            console.warn('Erro ao salvar no localStorage:', e);
            return false;
        }
    }

    function loadFromStorage() {
        try {
            const data = localStorage.getItem(STORAGE_KEY);
            if (data) {
                const parsed = JSON.parse(data);
                if (Array.isArray(parsed)) {
                    return parsed;
                }
            }
        } catch (e) {
            console.warn('Erro ao carregar do localStorage:', e);
        }
        return [];
    }

    function clearStorage() {
        localStorage.removeItem(STORAGE_KEY);
    }

    function getStorageSize() {
        try {
            const data = localStorage.getItem(STORAGE_KEY);
            return data ? data.length : 0;
        } catch (e) {
            return 0;
        }
    }

    // ============================================
    // STATE
    // ============================================
    let entries = [];
    let filterType = 'all';
    let filterText = '';
    let highlightPattern = '';
    let isMinimized = false;
    let nextId = 0;
    let autoSave = true;

    // ============================================
    // UI CREATION
    // ============================================
    function createUI() {
        const root = document.createElement('div');
        root.id = 'spy-root';
        root.innerHTML = `
            <div id="spy-header">
                <div id="spy-title">
                    📡 Remote Spy Pro
                    <span class="badge">${entries.length}</span>
                    <span class="badge saved" id="saved-badge">💾</span>
                </div>
                <div id="spy-controls">
                    <button id="spy-minimize" title="Minimizar">━</button>
                    <button id="spy-clear" title="Limpar">🗑</button>
                    <button id="spy-close" title="Fechar">✕</button>
                </div>
            </div>
            <div id="spy-toolbar">
                <input id="spy-filter" placeholder="🔍 Filtrar URLs..." />
                <select id="spy-filter-type">
                    <option value="all">Todos</option>
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                    <option value="DELETE">DELETE</option>
                    <option value="WS_SEND">WS Send</option>
                    <option value="WS_RECV">WS Recv</option>
                </select>
                <input id="spy-highlight" placeholder="✨ Destacar texto..." style="flex:0.7;min-width:80px;" />
                <button class="spy-btn primary" id="spy-save">💾 Salvar</button>
                <button class="spy-btn" id="spy-export">📥 Exportar</button>
            </div>
            <div id="spy-body"></div>
            <div id="spy-status">
                <span>📡 Monitorando requisições...</span>
                <span>Total: <span class="count" id="spy-count">0</span> | 💾 <span class="saved-count" id="spy-saved-count">0</span></span>
                <span class="spy-storage-info" id="storage-info">💾 0KB</span>
            </div>
        `;
        document.body.appendChild(root);
        bindEvents(root);
        updateStorageInfo(root);
        return root;
    }

    // ============================================
    // BIND EVENTS
    // ============================================
    function bindEvents(root) {
        // Minimize
        root.querySelector('#spy-minimize').addEventListener('click', () => {
            isMinimized = !isMinimized;
            root.classList.toggle('minimized');
            root.querySelector('#spy-minimize').textContent = isMinimized ? '□' : '━';
        });

        // Clear
        root.querySelector('#spy-clear').addEventListener('click', () => {
            if (confirm('Limpar todas as entradas? (Dados salvos permanecem)')) {
                entries = [];
                updateUI(root);
            }
        });

        // Close
        root.querySelector('#spy-close').addEventListener('click', () => {
            if (entries.length > 0) {
                if (confirm('Fechar Remote Spy? Os dados salvos permanecem no localStorage.')) {
                    root.remove();
                }
            } else {
                root.remove();
            }
        });

        // Filter
        const filterInput = root.querySelector('#spy-filter');
        filterInput.addEventListener('input', () => {
            filterText = filterInput.value.toLowerCase();
            updateUI(root);
        });

        // Filter type
        const filterTypeSelect = root.querySelector('#spy-filter-type');
        filterTypeSelect.addEventListener('change', () => {
            filterType = filterTypeSelect.value;
            updateUI(root);
        });

        // Highlight
        const highlightInput = root.querySelector('#spy-highlight');
        highlightInput.addEventListener('input', () => {
            highlightPattern = highlightInput.value.toLowerCase();
            updateUI(root);
        });

        // Save
        root.querySelector('#spy-save').addEventListener('click', () => {
            if (entries.length === 0) {
                alert('Nenhuma entrada para salvar.');
                return;
            }
            if (saveToStorage(entries)) {
                const btn = root.querySelector('#spy-save');
                btn.textContent = '✅ Salvo!';
                setTimeout(() => btn.textContent = '💾 Salvar', 1500);
                updateUI(root);
                updateStorageInfo(root);
                showNotification('💾 Dados salvos no localStorage!');
            } else {
                alert('❌ Erro ao salvar no localStorage. Verifique o espaço disponível.');
            }
        });

        // Export
        root.querySelector('#spy-export').addEventListener('click', () => {
            const data = JSON.stringify(entries, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `spy-export-${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
        });

        // Drag to move
        let isDragging = false;
        let dragStartX, dragStartY, startX, startY;
        const header = root.querySelector('#spy-header');
        
        header.addEventListener('mousedown', (e) => {
            if (e.target.closest('button')) return;
            isDragging = true;
            const rect = root.getBoundingClientRect();
            dragStartX = e.clientX - rect.left;
            dragStartY = e.clientY - rect.top;
            startX = rect.left;
            startY = rect.top;
            root.style.cursor = 'grabbing';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const x = e.clientX - dragStartX;
            const y = e.clientY - dragStartY;
            root.style.left = x + 'px';
            root.style.top = y + 'px';
            root.style.right = 'auto';
            root.style.bottom = 'auto';
        });

        document.addEventListener('mouseup', () => {
            isDragging = false;
            root.style.cursor = '';
        });
    }

    // ============================================
    // UPDATE UI
    // ============================================
    function updateUI(root) {
        const body = root.querySelector('#spy-body');
        const countEl = root.querySelector('#spy-count');
        const savedCountEl = root.querySelector('#spy-saved-count');
        const badge = root.querySelector('#spy-title .badge');
        const savedBadge = root.querySelector('#saved-badge');
        const saveBtn = root.querySelector('#spy-save');

        // Verificar se há dados salvos
        const savedEntries = loadFromStorage();
        const hasSavedData = savedEntries.length > 0;
        savedBadge.style.display = hasSavedData ? 'inline' : 'none';
        if (hasSavedData) {
            savedBadge.textContent = `💾 ${savedEntries.length}`;
        }

        let filtered = entries;

        // Filter by type
        if (filterType !== 'all') {
            filtered = filtered.filter(e => e.method === filterType);
        }

        // Filter by text
        if (filterText) {
            filtered = filtered.filter(e => 
                e.url.toLowerCase().includes(filterText) || 
                (e.body && e.body.toLowerCase().includes(filterText))
            );
        }

        // Highlight
        if (highlightPattern) {
            filtered = filtered.map(e => ({
                ...e,
                highlight: e.url.toLowerCase().includes(highlightPattern) ||
                          (e.body && e.body.toLowerCase().includes(highlightPattern))
            }));
        }

        body.innerHTML = '';
        filtered.forEach((entry, index) => {
            const div = document.createElement('div');
            div.className = 'spy-entry' + (entry.highlight ? ' highlight' : '');
            
            // Verificar se já está salvo
            const savedEntries = loadFromStorage();
            const isSaved = savedEntries.some(e => e.id === entry.id && e.url === entry.url);
            if (isSaved) {
                div.classList.add('saved-indicator');
            }
            
            const time = new Date(entry.timestamp).toLocaleTimeString();
            
            div.innerHTML = `
                <span class="method ${entry.method}">${entry.method}</span>
                <span class="path">${entry.path}</span>
                <span class="timestamp">${time}</span>
                ${isSaved ? '<span class="save-status">💾</span>' : ''}
                <br><span class="url">${entry.url}</span>
                ${entry.body ? `<div class="body-preview">📦 ${entry.body.substring(0, 200)}${entry.body.length > 200 ? '...' : ''}</div>` : ''}
                <div class="actions">
                    <button data-id="${entry.id}" class="replay-btn">▶ Replay</button>
                    <button data-id="${entry.id}" class="copy-btn">📋 Copiar</button>
                    ${entry.headers ? `<button data-id="${entry.id}" class="headers-btn">🔑 Headers</button>` : ''}
                    <button data-id="${entry.id}" class="save-btn">💾 Salvar</button>
                </div>
            `;
            
            body.appendChild(div);

            // Replay
            div.querySelector('.replay-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                const id = parseInt(e.target.dataset.id);
                const original = entries.find(ent => ent.id === id);
                if (original) {
                    replayRequest(original);
                }
            });

            // Copy
            div.querySelector('.copy-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                const id = parseInt(e.target.dataset.id);
                const original = entries.find(ent => ent.id === id);
                if (original) {
                    const fetchCode = generateFetchCode(original);
                    navigator.clipboard.writeText(fetchCode).then(() => {
                        const btn = e.target;
                        btn.textContent = '✅ Copiado!';
                        setTimeout(() => btn.textContent = '📋 Copiar', 1500);
                    }).catch(() => {
                        // Fallback
                        const textarea = document.createElement('textarea');
                        textarea.value = fetchCode;
                        document.body.appendChild(textarea);
                        textarea.select();
                        document.execCommand('copy');
                        textarea.remove();
                        const btn = e.target;
                        btn.textContent = '✅ Copiado!';
                        setTimeout(() => btn.textContent = '📋 Copiar', 1500);
                    });
                }
            });

            // Headers
            const headersBtn = div.querySelector('.headers-btn');
            if (headersBtn) {
                headersBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const id = parseInt(e.target.dataset.id);
                    const original = entries.find(ent => ent.id === id);
                    if (original && original.headers) {
                        alert('Headers:\n' + JSON.stringify(original.headers, null, 2));
                    }
                });
            }

            // Save individual
            div.querySelector('.save-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                const id = parseInt(e.target.dataset.id);
                const entry = entries.find(ent => ent.id === id);
                if (entry) {
                    const currentSaved = loadFromStorage();
                    // Verificar se já existe
                    const exists = currentSaved.some(e => e.id === entry.id && e.url === entry.url);
                    if (!exists) {
                        currentSaved.push(entry);
                        if (saveToStorage(currentSaved)) {
                            const btn = e.target;
                            btn.textContent = '✅ Salvo!';
                            setTimeout(() => btn.textContent = '💾 Salvar', 1500);
                            updateUI(root);
                            updateStorageInfo(root);
                            showNotification('💾 Entrada salva!');
                        }
                    } else {
                        alert('Esta entrada já está salva.');
                    }
                }
            });

            // Click to expand body
            div.addEventListener('click', () => {
                const preview = div.querySelector('.body-preview');
                if (preview && entry.body) {
                    if (preview.textContent.includes('...')) {
                        preview.textContent = '📦 ' + entry.body;
                    } else {
                        preview.textContent = '📦 ' + entry.body.substring(0, 200) + (entry.body.length > 200 ? '...' : '');
                    }
                }
            });
        });

        countEl.textContent = entries.length;
        savedCountEl.textContent = loadFromStorage().length;
        badge.textContent = entries.length;
        
        // Atualizar informações de storage
        updateStorageInfo(root);
    }

    // ============================================
    // UPDATE STORAGE INFO
    // ============================================
    function updateStorageInfo(root) {
        const infoEl = root.querySelector('#storage-info');
        if (infoEl) {
            const size = getStorageSize();
            const kb = (size / 1024).toFixed(1);
            const savedCount = loadFromStorage().length;
            infoEl.textContent = `💾 ${savedCount} entradas (${kb}KB)`;
        }
    }

    // ============================================
    // NOTIFICATION
    // ============================================
    function showNotification(message) {
        const notif = document.createElement('div');
        notif.style.cssText = 'position:fixed;top:20px;right:20px;background:#0a0e1a;color:#00f5d4;padding:12px 20px;border-radius:8px;border:1px solid #00f5d4;z-index:999999;font-family:monospace;font-size:14px;box-shadow:0 4px 20px rgba(0,0,0,0.8);animation:slideIn 0.3s ease;';
        notif.textContent = message;
        document.body.appendChild(notif);
        setTimeout(() => {
            notif.style.opacity = '0';
            notif.style.transition = 'opacity 0.5s';
            setTimeout(() => notif.remove(), 500);
        }, 2000);
    }

    // ============================================
    // GENERATE FETCH CODE
    // ============================================
    function generateFetchCode(entry) {
        const body = entry.body ? `body: ${entry.body}` : '';
        const headers = entry.headers ? `headers: ${JSON.stringify(entry.headers, null, 2)}` : '';
        return `fetch("${entry.url}", {\n  method: "${entry.method}",\n${headers ? `  ${headers},\n` : ''}${body ? `  ${body}\n` : ''}});`;
    }

    // ============================================
    // REPLAY REQUEST
    // ============================================
    function replayRequest(entry) {
        const options = {
            method: entry.method,
            headers: entry.headers || {}
        };
        if (entry.body) {
            try {
                options.body = entry.body;
            } catch(e) {
                options.body = entry.body;
            }
        }
        fetch(entry.url, options)
            .then(res => res.text())
            .then(data => {
                showNotification(`✅ Replay executado! Status: ${data.substring(0, 200)}`);
            })
            .catch(err => {
                showNotification(`❌ Erro no replay: ${err.message}`);
            });
    }

    // ============================================
    // HOOK FETCH
    // ============================================
    function hookFetch(root) {
        const originalFetch = window.fetch;
        window.fetch = function(...args) {
            const [url, options = {}] = args;
            const method = options.method || 'GET';
            const body = options.body || '';
            const headers = options.headers || {};

            // Extrair path
            let path = url;
            try {
                const urlObj = new URL(url);
                path = urlObj.pathname;
            } catch(e) {}

            const entry = {
                id: nextId++,
                timestamp: Date.now(),
                method: method,
                url: url,
                path: path,
                body: body,
                headers: headers
            };

            entries.push(entry);
            updateUI(root);

            return originalFetch.apply(this, args);
        };
    }

    // ============================================
    // HOOK XMLHttpRequest
    // ============================================
    function hookXHR(root) {
        const OriginalXHR = window.XMLHttpRequest;
        window.XMLHttpRequest = function() {
            const xhr = new OriginalXHR();
            let url = '';
            let method = '';
            let body = '';
            let headers = {};

            const originalOpen = xhr.open;
            xhr.open = function(m, u) {
                method = m;
                url = u;
                return originalOpen.apply(this, arguments);
            };

            const originalSetRequestHeader = xhr.setRequestHeader;
            xhr.setRequestHeader = function(name, value) {
                headers[name] = value;
                return originalSetRequestHeader.apply(this, arguments);
            };

            const originalSend = xhr.send;
            xhr.send = function(b) {
                body = b || '';

                let path = url;
                try {
                    const urlObj = new URL(url);
                    path = urlObj.pathname;
                } catch(e) {}

                const entry = {
                    id: nextId++,
                    timestamp: Date.now(),
                    method: method,
                    url: url,
                    path: path,
                    body: body,
                    headers: headers
                };

                entries.push(entry);
                updateUI(root);

                return originalSend.call(this, b);
            };

            return xhr;
        };
    }

    // ============================================
    // HOOK WebSocket
    // ============================================
    function hookWebSocket(root) {
        const OriginalWS = window.WebSocket;
        window.WebSocket = function(...args) {
            const ws = new OriginalWS(...args);
            const url = args[0];

            const originalSend = ws.send;
            ws.send = function(data) {
                const entry = {
                    id: nextId++,
                    timestamp: Date.now(),
                    method: 'WS_SEND',
                    url: url,
                    path: '/ws',
                    body: data.toString(),
                    headers: { 'WebSocket': true }
                };
                entries.push(entry);
                updateUI(root);
                return originalSend.call(this, data);
            };

            ws.addEventListener('message', (event) => {
                const entry = {
                    id: nextId++,
                    timestamp: Date.now(),
                    method: 'WS_RECV',
                    url: url,
                    path: '/ws',
                    body: event.data.toString(),
                    headers: { 'WebSocket': true }
                };
                entries.push(entry);
                updateUI(root);
            });

            return ws;
        };
    }

    // ============================================
    // INIT
    // ============================================
    if (document.getElementById('spy-root')) {
        alert('Remote Spy já está ativo!');
        return;
    }

    // Carregar dados salvos
    const savedEntries = loadFromStorage();
    if (savedEntries.length > 0) {
        entries = savedEntries;
        nextId = entries.length > 0 ? Math.max(...entries.map(e => e.id)) + 1 : 0;
    }

    const root = createUI();
    hookFetch(root);
    hookXHR(root);
    hookWebSocket(root);

    updateUI(root);

    console.log('%c📡 Remote Spy Pro v2.0 ativado!', 'font-size:20px; color:#00f5d4; font-weight:bold;');
    console.log('%cDados salvos: ' + loadFromStorage().length + ' entradas', 'color:#aaa;');
    console.log('%cUse o botão 💾 Salvar para persistir os dados.', 'color:#aaa;');
    console.log('%cOs dados são armazenados no localStorage do navegador.', 'color:#aaa;');

    showNotification('✅ Remote Spy Pro v2.0 ativado!');

    // Adicionar keyframe animation
    if (!document.getElementById('spy-keyframes')) {
        const kf = document.createElement('style');
        kf.id = 'spy-keyframes';
        kf.textContent = `
            @keyframes slideIn {
                from { transform: translateY(-20px); opacity: 0; }
                to { transform: translateY(0); opacity: 1; }
            }
        `;
        document.head.appendChild(kf);
    }

})();
